# DiscoWorld local environment — all values optional.
# Core 3D exploration works without any of these (static JSON).
# Discogs vars only needed for collection sync / OAuth login.
DISCOGS_TOKEN=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_USER_AGENT=DiscoWorld/2.0 +https://github.com/benjaminbelaga/discoworld

# CORS origin allowed by the API (matches the web service port).
DISCOWORLD_ORIGIN=http://localhost:5173
